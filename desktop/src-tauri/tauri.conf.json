{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "범타듀 밸리",
  "mainBinaryName": "beomtadew-valley",
  "version": "../../package.json",
  "identifier": "io.github.junlee122bot.beomtadew",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build:desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "범타듀 밸리",
        "url": "index.html",
        "width": 1600,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "focus": true,
        "dragDropEnabled": false,
        "backgroundColor": "#fdf6e3"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob: https://ogfpeqeoaznwjbrbedbx.supabase.co wss://ogfpeqeoaznwjbrbedbx.supabase.co",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-src": "'none'"
      },
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "category": "Game",
    "shortDescription": "일곱 친구의 마을",
    "longDescription": "친구 7명이 함께 노는 온라인 마을 게임 범타듀 밸리의 데스크톱 앱.",
    "copyright": "범타듀 밸리 친구들",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Korean",
          "English"
        ],
        "installMode": "currentUser"
      },
      "wix": {
        "language": [
          "ko-KR"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY (npx tauri signer generate -w ~/.tauri/beomtadew.key)",
      "endpoints": [
        "https://github.com/junlee122-bot/our-six-island/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["beomtadew"]
      }
    }
  }
}
